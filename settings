  <a href="settings.html" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-2.6V20a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1A1.7 1.7 0 0 0 8 15a1.7 1.7 0 0 0-1.6-1H6v-2.6h.4A1.7 1.7 0 0 0 8 10a1.7 1.7 0 0 0-.3-1.9l-.1-.1 1.8-1.8.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6v-.2h2.6V5a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1A1.7 1.7 0 0 0 19.4 10a1.7 1.7 0 0 0 1.6 1h.2v2.6H21a1.7 1.7 0 0 0-1.6 1.4z"/></svg>الإعدادات</a>
 </div>
</nav>
<script>
const key='mbh_theme';
function applyTheme(v){
  document.documentElement.dataset.theme=v;
  document.querySelectorAll('.theme').forEach(x=>x.classList.toggle('active',x.dataset.theme===v));
  localStorage.setItem(key,v);
}
document.querySelectorAll('.theme').forEach(x=>x.onclick=()=>applyTheme(x.dataset.theme));
applyTheme(localStorage.getItem(key)||'dark');
document.getElementById('langBtn').onclick=()=>{
  const cur=localStorage.getItem('mbh_lang')||'ar';
  const next=cur==='ar'?'en':'ar';
  localStorage.setItem('mbh_lang',next);
  document.getElementById('langText').textContent=next==='ar'?'العربية':'English';
};
document.getElementById('langText').textContent=(localStorage.getItem('mbh_lang')||'ar')==='ar'?'العربية':'English';
</script>
</body>
</html>
