  <div class="section">مساحة العمل</div>
  <div class="card">
    <a class="item" href="dashboard.html"><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg></span><div class="item-main"><div class="item-title">لوحة التحكم</div><div class="item-sub">ملخص الأداء والحملات والإشعارات</div></div><span class="chev">‹</span></a>
    <a class="item" href="automation-rules.html"><span class="icon">⚙</span><div class="item-main"><div class="item-title">قواعد الأتمتة</div><div class="item-sub">إنشاء وإدارة قواعد تشغيل الحملات</div></div><span class="chev">‹</span></a>
    <a class="item" href="insights.html"><span class="icon">⌁</span><div class="item-main"><div class="item-title">التحليلات والرسوم البيانية</div><div class="item-sub">قراءة الاتجاهات ومؤشرات الأداء</div></div><span class="chev">‹</span></a>
  </div>

  <div class="section">المظهر</div>
  <div class="card">
    <div class="theme-grid">
      <button class="theme active" data-theme="dark"><div class="theme-preview"></div>داكن</button>
      <button class="theme light" data-theme="light"><div class="theme-preview"></div>فاتح</button>
      <button class="theme system" data-theme="system"><div class="theme-preview"></div>النظام</button>
    </div>
  </div>

  <div class="section">الدعم</div>
  <div class="card">
    <a class="item" href="https://wa.me/201108712091" target="_blank" rel="noopener"><span class="icon">?</span><div class="item-main"><div class="item-title">الدعم والشكاوى</div><div class="item-sub">التواصل مع فريق الدعم وإرسال مشكلة أو ملاحظة</div></div><span class="chev">‹</span></a>
  </div>

  <div class="section">اللغة</div>
  <div class="card">
    <button class="item" id="langBtn" style="width:100%;border:0;background:transparent;color:inherit;text-align:right">
      <span class="icon">文</span><div class="item-main"><div class="item-title">لغة الواجهة</div><div class="item-sub" id="langText">العربية</div></div><span class="chev">‹</span>
    </button>
  </div>
</main>

<nav class="bottom">
 <div class="nav">
